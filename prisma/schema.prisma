// Prisma Schema untuk Sistem Manajemen Kontrakan
// Berdasarkan PRD.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  USER
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum RentalStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  UNPAID
  WAITING_PAYMENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceSource {
  MANUAL
  BATCH
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

/// Pengguna aplikasi (Admin pemilik kontrakan atau User penyewa)
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  rentals          Rental[]
  verifiedPayments Payment[]  @relation("VerifiedPayments")
  sessions         Session[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// Sesi autentikasi berbasis database session (Secure session-based authentication)
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Data Properti/Kontrakan Utama (dapat memiliki banyak unit)
model Property {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?        @db.Text
  address          String         @db.Text
  monthlyPriceFrom Decimal        @map("monthly_price_from") @db.Decimal(12, 2)
  status           PropertyStatus @default(DRAFT)
  facilities       String[]       @default([])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  units  Unit[]
  images PropertyImage[]

  @@index([slug])
  @@index([status])
  @@map("properties")
}

/// Foto galeri properti/kontrakan
model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  url        String   @db.Text
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  isCover    Boolean  @default(false) @map("is_cover")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

/// Data Kamar / Unit di dalam Properti
model Unit {
  id          String     @id @default(cuid())
  propertyId  String     @map("property_id")
  name        String     // e.g. "Unit A01", "Kamar 3"
  description String?    @db.Text
  monthlyRent Decimal    @map("monthly_rent") @db.Decimal(12, 2)
  status      UnitStatus @default(AVAILABLE)
  facilities  String[]   @default([])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentals  Rental[]

  @@index([propertyId])
  @@index([status])
  // Mencegah nama unit/kamar ganda dalam satu properti (sumber tagihan ganda)
  @@unique([propertyId, name], name: "property_unit_name_unique")
  @@map("units")
}

/// Kontrak / Relasi Penyewaan antara Penyewa (User) dan Unit
model Rental {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  unitId      String       @map("unit_id")
  startDate   DateTime     @map("start_date")
  endDate     DateTime?    @map("end_date")
  monthlyRent Decimal      @map("monthly_rent") @db.Decimal(12, 2)
  status      RentalStatus @default(ACTIVE)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([userId])
  @@index([unitId])
  @@index([status])
  @@map("rentals")
}

/// Tagihan Bulanan (Billing System)
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @map("invoice_number")
  rentalId      String        @map("rental_id")
  billingPeriod String        @map("billing_period") // format: "YYYY-MM" (e.g. "2026-09")
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(UNPAID)
  // MANUAL = dibuat admin via tombol "Buat Tagihan" (selalu tampil ke penyewa).
  // BATCH = hasil "Terbitkan Massal" (bulan depan disembunyikan sampai bulannya tiba).
  source        InvoiceSource @default(MANUAL)
  paidAt        DateTime?     @map("paid_at")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  rental   Rental    @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  payments Payment[]

  // Constraint Penting PRD Rule 2: Mencegah duplicate invoice per billing period
  @@unique([rentalId, billingPeriod], name: "rental_billing_period_unique")
  @@index([rentalId])
  @@index([billingPeriod])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

/// Rekening Bank Penerima Transfer Manual (dikelola Admin)
model PaymentAccount {
  id            String   @id @default(cuid())
  bankName      String   @map("bank_name")      // e.g. "Bank BCA", "Bank Mandiri"
  accountNumber String   @map("account_number") // Nomor rekening
  accountName   String   @map("account_name")   // Atas nama
  qrCodeUrl     String?  @map("qr_code_url")    // Opsional QRIS/QR image
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  payments Payment[]

  @@map("payment_accounts")
}

/// Pembayaran / Bukti Transfer Manual dari Penyewa
model Payment {
  id               String        @id @default(cuid())
  invoiceId        String        @map("invoice_id")
  paymentAccountId String?       @map("payment_account_id")
  amount           Decimal       @db.Decimal(12, 2)
  transferDate     DateTime      @map("transfer_date")
  senderBank       String        @map("sender_bank") // Bank pengirim penyewa
  senderName       String        @map("sender_name") // Nama pemilik rekening pengirim
  proofFileUrl     String        @map("proof_file_url") @db.Text
  notes            String?       @db.Text
  status           PaymentStatus @default(PENDING)
  rejectionReason  String?       @map("rejection_reason") @db.Text
  verifiedById     String?       @map("verified_by")
  verifiedAt       DateTime?     @map("verified_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  verifiedBy     User?           @relation("VerifiedPayments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@index([transferDate])
  @@map("payments")
}

/// Audit Trail Log untuk pencatatan aktivitas krusial sistem (PRD Sec 41 & 73)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id") // Null jika aksi dipicu otomatis oleh sistem
  action     String   // e.g. "ADMIN_APPROVED_PAYMENT", "PAYMENT_REJECTED", "INVOICE_CREATED"
  entityType String   @map("entity_type") // e.g. "Payment", "Invoice", "Rental", "Unit"
  entityId   String   @map("entity_id")
  metadata   Json?    // Menyimpan snapshot perubahan status, alasan penolakan, ip, dll
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Notifikasi In-App untuk Penyewa
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, INVOICE, PAYMENT, WARNING
  linkUrl   String?  @map("link_url") // URL tujuan jika notifikasi diklik
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

